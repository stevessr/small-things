{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stevessr/small-things/blob/harness/agentos/docs/agentos-plan.schema.json",
  "title": "AgentOS Harness v0.4 execution plan",
  "description": "Static structural validation only. Cross-task dependencies, cycles and resource admission are validated by agentos.plan_lint. Do not add $schema to execution plans.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_units": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "default": 1024
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 128
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deps": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "tenant": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "process",
            "model",
            "tool"
          ],
          "default": "process"
        },
        "cpu_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 1
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1048576,
          "default": 256
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "default": 30
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    }
  }
}
