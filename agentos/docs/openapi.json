{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentOS Harness localhost read-only API",
    "version": "0.4.0",
    "description": "Strict localhost interface. Requires Host 127.0.0.1:actual_port; intentionally has no authentication or write endpoints. Prototype, not public API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8765"
        }
      }
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Server liveness (not Agent health)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "summary": "Full, unpaginated summary or bounded summary page",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "summary"
              ]
            },
            "description": "summary removes stdout/stderr/resource_metrics from tasks and sets events=[]"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "description": "Requires view=summary and limit. Zero-based index of the first task in lexicographically sorted task IDs."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "description": "Requires view=summary and offset. Caps response to this many tasks and corresponding DAG entries."
          }
        ],
        "responses": {
          "200": {
            "description": "Full state or summary projection; offset+limit limits tasks/dag/declared_by only, total/counts remain global",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Snapshot"
                    },
                    {
                      "$ref": "#/components/schemas/SummarySnapshot"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or out-of-range pagination query"
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          },
          "500": {
            "description": "Unreadable/oversized report or JSON error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/task/{id}": {
      "get": {
        "summary": "Fetch complete task detail on demand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task": {
                      "$ref": "#/components/schemas/Task"
                    },
                    "spec": {
                      "$ref": "#/components/schemas/TaskSpec"
                    }
                  },
                  "required": [
                    "task",
                    "spec"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          },
          "404": {
            "description": "Invalid or unknown task ID"
          },
          "500": {
            "description": "Unreadable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/changes": {
      "get": {
        "summary": "SSE notification that report or trace changed",
        "description": "An initial data: <version> event is sent at connection. Further events originate from Linux inotify; : heartbeat comments are not refresh events. No replay or Last-Event-ID support.",
        "responses": {
          "200": {
            "description": "Change notifications",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE lines: data: <integer>\\n\\n or : heartbeat\\n\\n"
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          },
          "503": {
            "description": "Linux inotify unavailable"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Web dashboard HTML",
        "responses": {
          "200": {
            "description": "HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          }
        }
      }
    },
    "/app.js": {
      "get": {
        "summary": "Web dashboard JavaScript",
        "responses": {
          "200": {
            "description": "JS",
            "content": {
              "text/javascript": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          }
        }
      }
    },
    "/styles.css": {
      "get": {
        "summary": "Web dashboard CSS",
        "responses": {
          "200": {
            "description": "CSS",
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Host header did not match 127.0.0.1:port"
          }
        }
      }
    },
    "/api/records": {
      "get": {
        "summary": "Strict cursor replay of observed supervisor facts, not native conversation/process resume",
        "description": "Read-only full-JSONL replay: an in-memory sparse offset index validates every complete record in sequence from zero. It scans historical data once per server/file generation and only appended records later. A partial trailing line is deferred; malformed complete lines, gaps, session changes and legacy traces yield 409. No native model/process resume or on-disk index.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1000000000000,
              "default": -1
            },
            "description": "Last accepted seq; -1 for initial fetch"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "description": "Required when after >=0; prevents cross-run replay"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified contiguous facts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordWindow"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or unsupported cursor fields"
          },
          "403": {
            "description": "Invalid localhost Host header"
          },
          "409": {
            "description": "Evidence gap, legacy trace, different session, or cursor beyond observed history"
          },
          "500": {
            "description": "Trace could not be read"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "blocked"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "elapsed_s": {
            "type": "number"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "isolation": {
            "type": "string"
          },
          "filesystem_branch": {
            "type": "string"
          },
          "filesystem_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_metrics": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "TaskSpec": {
        "type": "object",
        "properties": {
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenant": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "process",
              "model",
              "tool"
            ]
          },
          "priority": {
            "type": "integer"
          },
          "cpu_units": {
            "type": "integer"
          },
          "memory_mib": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "Event": {
        "type": "object",
        "properties": {
          "time_ns": {
            "type": "integer"
          },
          "event": {
            "type": "string",
            "enum": [
              "admitted",
              "declared",
              "started",
              "retry",
              "declaration_rejected",
              "finished",
              "blocked",
              "control_requested",
              "control_handled"
            ]
          },
          "task": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Per AgentOS execution supervisor record stream; not a native model event counter"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "agent_path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Declaring ancestors, [] for initial tasks; distinct from DAG deps"
          }
        },
        "required": [
          "time_ns",
          "event"
        ],
        "additionalProperties": true
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "tasks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "dag": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TaskSpec"
            }
          },
          "declared_by": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "counts": {
            "type": "object",
            "required": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "blocked"
            ],
            "additionalProperties": false,
            "properties": {
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "succeeded": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "isolation": {
            "type": "string"
          },
          "budget": {
            "type": "object",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          },
          "updated_utc": {
            "type": "string",
            "format": "date-time"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Observed AgentOS Supervisor execution ID; null when legacy data lacks identity"
          },
          "last_seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -1,
            "description": "Last observed Supervisor record sequence; null when not evidenced"
          }
        },
        "required": [
          "schema",
          "tasks",
          "dag",
          "declared_by",
          "events",
          "counts",
          "total",
          "isolation",
          "budget",
          "context",
          "updated_utc",
          "session_id",
          "last_seq"
        ],
        "additionalProperties": true
      },
      "SummarySnapshot": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "tasks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "dag": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TaskSpec"
            }
          },
          "declared_by": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "counts": {
            "type": "object",
            "required": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "blocked"
            ],
            "additionalProperties": false,
            "properties": {
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "succeeded": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "isolation": {
            "type": "string"
          },
          "budget": {
            "type": "object",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          },
          "updated_utc": {
            "type": "string",
            "format": "date-time"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Observed AgentOS Supervisor execution ID; null when legacy data lacks identity"
          },
          "last_seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -1,
            "description": "Last observed Supervisor record sequence; null when not evidenced"
          }
        },
        "required": [
          "schema",
          "tasks",
          "dag",
          "declared_by",
          "events",
          "counts",
          "total",
          "isolation",
          "budget",
          "context",
          "updated_utc",
          "session_id",
          "last_seq"
        ],
        "additionalProperties": true,
        "description": "When offset+limit are supplied, tasks/dag/declared_by include only the requested sorted page (max 40); total and counts still cover all tasks. Events=[] and outputs omitted. Without pagination, all task summaries are returned."
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "RecordWindow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "session_id",
          "records",
          "next_seq",
          "has_more"
        ],
        "properties": {
          "schema": {
            "type": "integer",
            "const": 1
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordedSupervisorEvent"
            }
          },
          "next_seq": {
            "type": "integer",
            "minimum": -1
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "RecordedSupervisorEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "type": "object",
            "required": [
              "seq",
              "session_id",
              "agent_path",
              "time_ns",
              "event"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "session_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "agent_path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "time_ns": {
                "type": "integer"
              },
              "event": {
                "type": "string"
              }
            }
          }
        ],
        "description": "A complete verified supervisor fact returned by /api/records. Legacy /api/state event tails can lack cursor fields."
      }
    }
  }
}
